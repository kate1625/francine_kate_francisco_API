# Copy this file to .env and update the values below

# Application Settings
APP_NAME=Lavalust
APP_KEY=
APP_ENV=development

# Database Configuration
DB_DRIVER=
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_CHARSET=
DB_PREFIX=
DB_SSL_CA=
DB_SSL_MODE=REQUIRED

# For API
API_HELPER_ENABLED=false
API_ALLOWED_ORIGIN=*
JWT_SECRET=
REFRESH_TOKEN_KEY=

# Enable only temporarily while running migrations in a trusted environment.
MIGRATION_ENABLED=false